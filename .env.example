# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.
# Cadena de conexión de Neon (con pooler).
DATABASE_URL=
# Secreto de Better Auth: 32 caracteres o más, aleatorio. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# URL pública de la app (http://localhost:3000 en desarrollo). En los previews de Vercel se usa VERCEL_URL.
BETTER_AUTH_URL=
# Resend (correo de "Olvidé mi contraseña"). Sin dominio verificado, el remitente es "Tiza <onboarding@resend.dev>"
# y Resend solo entrega al correo dueño de la cuenta.
RESEND_API_KEY=
CORREO_REMITENTE=
# Pruebas contra Neon (src/db/*.bd.test.ts). Opcional: cadena de una rama de Neon solo para pruebas.
# Sin ella usan DATABASE_URL, que es la de producción. Se ejecutan con PRUEBAS_BD=1 (ver tasks del change agenda).
DATABASE_URL_PRUEBAS=
PRUEBAS_BD=
# Vercel Blob (comprobantes y fotos del servicio). La tienda debe ser PRIVADA (el acceso no se puede cambiar después).
BLOB_READ_WRITE_TOKEN=
# Secreto del cron diario de archivos huérfanos: aleatorio, 32 caracteres o más.
CRON_SECRET=
# Número de WhatsApp para coordinar, con código de país y solo dígitos (sin + ni espacios). Opcional: sin él no hay enlace.
WHATSAPP_NUMERO=
